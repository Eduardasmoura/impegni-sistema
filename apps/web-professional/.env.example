# Copie para .env.local e preencha com os valores do projeto Supabase
# (lcdzrahvhilxvkklulaa). Nunca commitar .env.local nem colocar a
# service_role key aqui — só a anon key, pública por definição.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Domínio raiz do painel por subdomínio de empresa ({slug}.<este domínio>,
# ex.: studio-bella.app.impegni.com.br). Em produção: "app.impegni.com.br".
# Sem isso, cai no fallback "localhost:3000" (dev) — acesso pelo domínio
# "nu" continua funcionando normalmente (login/cadastro/onboarding), só não
# tem subdomínio nenhum pra resolver.
NEXT_PUBLIC_ROOT_DOMAIN=
