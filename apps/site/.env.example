# Copie para .env.local e preencha com os valores do projeto Supabase
# (lcdzrahvhilxvkklulaa). Nunca commitar .env.local nem colocar a
# service_role key aqui — só a anon key, pública por definição.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL de produção do web-professional (ex.: https://app.inovaflow.com.br) —
# é pra onde o botão "Começar teste grátis" aponta (ver src/lib/format.ts).
# Sem isso, cai no fallback http://localhost:3000 — ACHADO da auditoria de
# lançamento: confirmar que está preenchido antes de publicar o site.
NEXT_PUBLIC_APP_URL=

# URL de produção deste próprio site (ex.: https://inovaflow.com.br) — usada
# só no metadataBase de SEO/Open Graph (src/app/layout.tsx). Sem isso, cai
# no fallback http://localhost:3003, o que deixa a URL de preview/OG errada.
NEXT_PUBLIC_SITE_URL=
