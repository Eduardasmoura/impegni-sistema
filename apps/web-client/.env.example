# Copie para .env.local e preencha com os valores do projeto Supabase
# (lcdzrahvhilxvkklulaa). Nunca commitar .env.local nem colocar a
# service_role key aqui — só a anon key, pública por definição.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Domínio raiz do agendamento por subdomínio ({slug}.<este domínio>).
# Em produção: o domínio real (ex.: inova.app). Sem isso, cai no fallback
# "localhost:3001" (dev) — o próprio app já loga um erro no console do
# servidor em produção se esta variável não estiver definida.
NEXT_PUBLIC_ROOT_DOMAIN=
